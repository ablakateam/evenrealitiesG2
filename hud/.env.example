# ─── VOX glasses app (hud/) ────────────────────────────────────────────────
# Copy to hud/.env and fill in. NEVER commit the real file.
#
#   cp hud/.env.example hud/.env
#
# Vite inlines every VITE_* value into the bundle at build time, so these end
# up as plain strings inside the packed .ehpk. That is acceptable for a
# Private/Beta build only you can download. It is NOT acceptable for a public
# Production release — see docs/SECURITY.md.

# REQUIRED — bare hostname of your VOX server (no scheme, no trailing slash).
# pack.sh substitutes this into app.json's network permission whitelist,
# which is what allows the glasses to reach your server at all.
#   e.g. vox.example.com
VOX_DOMAIN=your-server-domain.example

# REQUIRED — full origin of the same server, used by the app at runtime.
VITE_VOX_SERVER=https://your-server-domain.example

# REQUIRED — the shared secret your server was seeded with
# (BOOTSTRAP_SECRET in server/.env, or a rotated one from the dashboard).
# The glasses send this as `Authorization: Bearer <secret>` on every request.
VITE_VOX_SECRET=your_shared_secret_here

# OPTIONAL — support address substituted into the hosted legal pages at
# deploy time by web/deploy.sh. Omit and the pages show a placeholder.
VOX_SUPPORT_EMAIL=you@example.com
