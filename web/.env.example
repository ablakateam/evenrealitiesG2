# ─── VOX dashboard (web/) ─────────────────────────────────────────────────
# Copy to web/.env for local development. Not needed in production.
#
#   cp web/.env.example web/.env

# [optional] Origin of the VOX API.
#
# Leave EMPTY for production: Nginx serves the built dashboard and proxies
# /api and /webhooks to the Node process on the same origin, so relative
# paths resolve correctly.
#
# Set it when running `npm run dev` locally against a deployed server, e.g.
#   VITE_API_BASE=https://your-server-domain.example
VITE_API_BASE=
