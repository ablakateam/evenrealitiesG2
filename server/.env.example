# VOX server environment template
# Copy to /opt/vox/.env on the VPS and fill values.
# Never commit a real .env to git.

NODE_ENV=production
PORT=3000

# SQLite path (created on first boot if missing)
DB_PATH=/opt/vox/data/vox.db

# Master key for libsodium secretbox (32 random bytes, base64-encoded)
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# Bootstrap shared-secret for first-launch pairing
# After initial pairing the secret is hashed into DB; this env var is no longer required
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BOOTSTRAP_SECRET=

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Public origin of this server (required) — used to build Twilio webhook
# URLs for signature verification. Must match the deployment's real domain.
TWILIO_WEBHOOK_BASE_URL=https://your-server-domain.example

# Public origin for outbound attribution headers (optional; falls back to
# TWILIO_WEBHOOK_BASE_URL).
# PUBLIC_BASE_URL=

# --- Twilio (SMS) ---
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# --- LLM providers (at least one required for compose) ---
# OPENAI_KEY=
# ANTHROPIC_KEY=
# OPENROUTER_KEY=
# OLLAMA_CLOUD_KEY=

# --- OAuth (P9 onboarding wizard) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
